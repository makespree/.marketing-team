{
  "functions": [
    {
      "source": ".",
      "codebase": "marketing",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        ".local",
        ".cache",
        "workspace",
        "skills",
        "tests",
        "web",
        "dist",
        "*-debug.log*",
        "firebase.local.json"
      ]
    }
  ],
  "hosting": {
    "site": "YOUR_REVIEW_HOSTING_SITE",
    "public": "dist",
    "ignore": [
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "marketingApi",
          "region": "asia-south1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      }
    ]
  }
}
