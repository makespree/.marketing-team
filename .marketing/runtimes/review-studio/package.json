{
  "name": "portable-marketing-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "lib/server/api.js",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "adapt": "node cli.mjs adapt",
    "start": "node cli.mjs start",
    "build": "tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "tsc -p tsconfig.server.json && node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "gcp-build": ""
  },
  "dependencies": {
    "firebase": "12.18.0",
    "firebase-admin": "14.3.0",
    "firebase-functions": "7.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/node": "26.5.0",
    "@vitejs/plugin-react": "6.1.1",
    "firebase-tools": "15.29.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "tsx": "4.23.13"
  }
}
